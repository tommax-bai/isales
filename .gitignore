.claude/settings.local.json
.claude/scheduled_tasks.lock
__pycache__/
*.pyc
.DS_Store
.env
# Real cloud env values (4 services) are tracked in this private repo per
# explicit user decision (single-collaborator + internal PoC). See
# deploy/cloud/env/README.md for the policy and rotation procedure.
!deploy/cloud/env/api.env
!deploy/cloud/env/engine.env
!deploy/cloud/env/scheduler.env
!deploy/cloud/env/worker.env
# Offline backup of Fernet master key + RTC AppKey + admin pw — never git.
deploy/cloud/env/SECRETS.md
.venv
node_modules/

# Vendor RTC SDK binaries / headers — proprietary, never commit. The
# canonical location is `~/codes/vendor/DingRTC_*_SDK_*/` (sibling of
# this repo, outside any tree); these globs are forward-compat for any
# in-tree placement (e.g. a developer unpacking a vendor zip inside
# the meta-repo by mistake) and the `engine-rtc-dingrtc-migration § 9.7`
# 三端一致检查。
vendor/DingRTC_*_SDK_*/
**/vendor/DingRTC_*_SDK_*/
