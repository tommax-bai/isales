# /etc/isales/env/engine.env  (0640 root:isales)
# isales-engine environment variables.
# Source of truth: isales-engine/README.md "Required env".
# Cross-service consistency:
#   ISALES_DATABASE_URL  must match api/scheduler/worker/telephony-api
#   ISALES_REDIS_URL     must match api/scheduler/worker

ISALES_DATABASE_URL=postgresql+asyncpg://isales:<change-me>@localhost:5432/isales
ISALES_REDIS_URL=redis://localhost:6379/0

ISALES_ENGINE_LLM_PROVIDER=mock
ISALES_ENGINE_ASR_PROVIDER=mock
ISALES_ENGINE_TTS_PROVIDER=mock
ISALES_ENGINE_TELEPHONY_MODE=mock
ISALES_ENGINE_PIPELINE_DEFAULT_TIMEOUT_MS=8000
ISALES_ENGINE_MAX_NO_PROGRESS_SECONDS=60
ISALES_ENGINE_MOCK_CONNECT_DELAY_MS=200
ISALES_ENGINE_GRACEFUL_SHUTDOWN_TIMEOUT_S=30

TZ=Asia/Shanghai
