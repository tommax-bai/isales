# /etc/isales/env/scheduler.env  (0640 root:isales)
# isales-scheduler environment variables.
# Source of truth: isales-scheduler/README.md "Environment".
# Cross-service consistency:
#   ISALES_DATABASE_URL  must match api/engine/worker/telephony-api
#   ISALES_REDIS_URL     must match api/engine/worker

ISALES_DATABASE_URL=postgresql+asyncpg://isales:<change-me>@localhost:5432/isales
ISALES_REDIS_URL=redis://localhost:6379/0

ISALES_TELEPHONY_API_BASE=http://127.0.0.1:8001
ISALES_SCHEDULER_TICK_INTERVAL=60
ISALES_SCHEDULER_BATCH_SIZE=50
ISALES_SCHEDULER_HISTORY_N=3
ISALES_MAX_CONCURRENCY=8
ISALES_SELECT_TIMEOUT_SECONDS=1.0

TZ=Asia/Shanghai
