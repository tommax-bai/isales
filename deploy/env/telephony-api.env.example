# /etc/isales/env/telephony-api.env  (0640 root:isales)
# isales-telephony telephony-api environment variables.
# Source of truth: isales-telephony/README.md "Environment" (api column).
# Cross-service consistency:
#   ISALES_DATABASE_URL  must match api/engine/scheduler/worker
#   ISALES_REDIS_URL     must match api/engine/scheduler/worker
#   ISALES_JWT_SECRET    MUST match isales-api (api signs, telephony-api verifies)

ISALES_DATABASE_URL=postgresql+asyncpg://isales:<change-me>@localhost:5432/isales
ISALES_REDIS_URL=redis://localhost:6379/0
ISALES_JWT_SECRET=<change-me>
