# /etc/isales/env/modem-controller.env  (0640 root:isales)
# isales-telephony modem-controller environment variables.
# Source of truth: isales-telephony/README.md "Environment" (modem column).
# Cross-service consistency:
#   ISALES_DATABASE_URL  must match api/engine/scheduler/worker/telephony-api

ISALES_DATABASE_URL=postgresql+asyncpg://isales:<change-me>@localhost:5432/isales

# IPC socket between engine and modem-controller (default /var/run/isales/modem.sock).
ISALES_MODEM_SOCKET=/var/run/isales/modem.sock

# ISALES_SKIP_UDEV=1   # dev/macOS only — never set in production
# MOCK_DIAL_DELAY_MS=1000      # mock harness only
# MOCK_CALL_DURATION_MS=5000   # mock harness only
