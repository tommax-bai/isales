# /etc/isales/env/worker.env  (0640 root:isales)
# isales-worker environment variables.
# Source of truth: isales-worker/README.md "Environment".
# Cross-service consistency:
#   ISALES_DATABASE_URL  must match api/engine/scheduler/telephony-api
#   ISALES_REDIS_URL     must match api/engine/scheduler
#   ISALES_FERNET_KEY    must match isales-api

ISALES_DATABASE_URL=postgresql+asyncpg://isales:<change-me>@localhost:5432/isales
ISALES_REDIS_URL=redis://localhost:6379/0
ISALES_FERNET_KEY=<change-me>

ISALES_WORKER_LLM_PROVIDER=mock
ISALES_WEBHOOK_DEFAULT_TIMEOUT_SECONDS=10
ISALES_WORKER_RETRY_TICK_INTERVAL=60
ISALES_WORKER_RETRY_BATCH_SIZE=50
ISALES_WORKER_METRICS_TICK_INTERVAL=60

TZ=Asia/Shanghai
