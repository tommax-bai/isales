# /etc/isales/env/api.env  (0640 root:isales)
# isales-api environment variables.
# Source of truth: isales-api/README.md "Required environment".
# Cross-service consistency:
#   ISALES_DATABASE_URL  must match engine/scheduler/worker/telephony-api
#   ISALES_REDIS_URL     must match engine/scheduler/worker
#   ISALES_JWT_SECRET    must match telephony-api (HS256 signer/verifier pair)

ISALES_DATABASE_URL=postgresql+asyncpg://isales:<change-me>@localhost:5432/isales
ISALES_REDIS_URL=redis://localhost:6379/0
ISALES_JWT_SECRET=<change-me>
ISALES_ADMIN_USER=admin
ISALES_ADMIN_PASSWORD_HASH=<change-me>
