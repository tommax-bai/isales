# ~/.config/isales/edge.env  (0600, owned by current user)
#
# A2 cloud-edge: edge-side environment file consumed by isales-telephony-edge
# (entry-point `isales-telephony-edge`).
# Source of truth: isales-telephony/isales_telephony/edge/main.py.

# ---------- identity & cloud-edge endpoint ----------
# Static long-lived JWT issued by cloud-side `isales-edge-token-mint` CLI.
# The `sub` claim must equal the cloud-side ISALES_ENGINE_EDGE_DEVICE_ID.
# C2 replaces this with activation-code → tenant-scoped short JWT.
ISALES_EDGE_DEVICE_TOKEN=<change-me>
# host:port for the cloud-edge gRPC bidi stream. nginx fronts :50051 with TLS;
# point this at the cloud domain or the ECS public IP.
ISALES_CLOUD_EDGE_ENDPOINT=cloud.isales.example.com:50051

# ---------- SQLite buffer ----------
# WAL DB for offline CallEvent / HardwareAlert; flushed weak-ACK on reconnect.
# Leave unset for in-memory only (dev / CI).
ISALES_EDGE_EVENT_BUFFER_PATH=~/Library/Application Support/isales/sqlite/edge_buffer.db

# ---------- modem-controller ----------
# Optional driver override (default: SimcomA7670 family via udev probe).
# ISALES_MODEM_DRIVER=
# Optional explicit serial port if you don't want udev auto-detect.
# ISALES_MODEM_SERIAL_PATH=/dev/tty.usbserial-AB0123CD

# ---------- audio-bridge ----------
# macos | linux  (mock fallback is the in-process MacosRtcSession used by
# tests; A2 production runs `macos`).
ISALES_EDGE_AUDIO_BACKEND=macos

# ---------- diagnostics ----------
ISALES_LOG_LEVEL=INFO
