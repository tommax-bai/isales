# ~/.config/isales/edge.env  (0600, owned by current user)
#
# A2 cloud-edge: edge-side environment file consumed by isales-telephony.
# Source of truth: arch-cloud-edge-split design.md §Decision 5 (control plane)
#                  and isales-telephony/README.md.

# ---------- identity ----------
ISALES_EDGE_DEVICE_ID=edge-01
# Static long-lived JWT issued by cloud-side `isales-edge-token-mint` CLI.
# C2 replaces this with activation-code → tenant-scoped short JWT.
ISALES_EDGE_DEVICE_TOKEN=<change-me>

# ---------- cloud-edge gRPC ----------
ISALES_CLOUD_EDGE_URL=cloud.isales.example.com:50051
# TLS verification on by default; trust the Let's Encrypt chain from the system
# trust store. Override to a custom CA bundle if needed.
# ISALES_CLOUD_EDGE_CA_BUNDLE=/etc/ssl/cert.pem

# Heartbeat cadence (matches cloud-side ISALES_CLOUD_EDGE_HEARTBEAT_TIMEOUT_S budget).
ISALES_EDGE_HEARTBEAT_INTERVAL_S=30

# Exponential backoff on disconnect (seconds).
ISALES_EDGE_RECONNECT_MIN_S=1
ISALES_EDGE_RECONNECT_MAX_S=60

# ---------- SQLite buffer ----------
# WAL DB for offline CallEvent / HardwareAlert; flushed weak-ACK on reconnect.
ISALES_EDGE_SQLITE_PATH=~/Library/Application Support/isales/sqlite/edge_buffer.db
ISALES_EDGE_SQLITE_RING_CAPACITY=10000

# ---------- modem-controller ----------
# Symlink resolved at first run; if you swap modems, kickstart will re-probe.
ISALES_MODEM_SERIAL_PATH=/dev/tty.usbserial-AB0123CD
ISALES_MODEM_RECORDING_DIR=~/Library/Application Support/isales/recordings

# ---------- audio-bridge (ARTC SDK macOS) ----------
# A2 uses mock MacosRtcSession (decision: macOS Obj-C SDK has no Python wrapper).
# Real ARTC macOS audio is D1 (Windows) range. Leave at "mock" until then.
ISALES_AUDIO_BACKEND=mock
# When real SDK lands, set to "aliyun_rtc" and fill credentials/path:
# ALIYUN_RTC_APP_ID=<change-me>
# ISALES_ARTC_SDK_PATH=~/Library/Application Support/isales/vendor/aliyun-artc-macos-python

# ---------- telephony-api loopback ----------
# Loopback-only (127.0.0.1); web/CLI device queries from this machine.
ISALES_TELEPHONY_API_BIND=127.0.0.1:8001
# A2: this endpoint adds `Deprecation: 1` response header on /devices/select.
# Task 7.7.

# ---------- diagnostics ----------
ISALES_EDGE_LOG_LEVEL=info
