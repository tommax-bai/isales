<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Managed by iSales install.sh.
  EnvironmentVariables is rewritten on every install from
  /etc/isales/env/modem-controller.env (launchd has no EnvironmentFile=).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.isales.modem-controller</string>
    <key>UserName</key>
    <string>_isales</string>
    <key>GroupName</key>
    <string>_isales</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/isales/current/venv/bin/modem-controller</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/opt/isales/current/isales-telephony</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/opt/isales/logs/modem-controller.out.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/isales/logs/modem-controller.err.log</string>
    <!--
      impl-real-at: ISALES_MODEM_SERIAL_PATH is REQUIRED to start
      modem-controller. install.sh inlines /etc/isales/env/modem-controller.env
      into the dict below; that file MUST contain ISALES_MODEM_SERIAL_PATH=
      <tty path>. On Mac mini deployments the path is typically
      /dev/cu.usbmodem* (run `ls /dev/cu.usbmodem*` after plugging the modem
      to discover it). ISALES_MODEM_DRIVER (a7670 / sim800c / quectel_uc20)
      is optional; if absent the driver is auto-detected via AT+GMI/AT+GMM.
      ISALES_ALLOW_MOCK_AT MUST NOT be set in production — it is the dev/CI
      escape hatch handled by modem_controller/main.py:_make_at_client.
    -->
    <key>EnvironmentVariables</key>
    <dict/>
</dict>
</plist>
